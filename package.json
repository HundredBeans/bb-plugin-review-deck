{
  "name": "bb-plugin-review-deck",
  "version": "0.1.0",
  "description": "Guided, slide-by-slide code review decks that agents write and humans click through.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HundredBeans/bb-plugin-review-deck.git"
  },
  "homepage": "https://github.com/HundredBeans/bb-plugin-review-deck#readme",
  "bugs": {
    "url": "https://github.com/HundredBeans/bb-plugin-review-deck/issues"
  },
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Review Deck",
    "description": "Walk through a code change one slide at a time: grouped files, a plain-language summary, findings pinned to the exact lines, and diagrams. Agents publish the deck after they review.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/schema.mts && tsx tests/gitlab-position.mts && tsx tests/slash-menu.mts && tsx tests/chat-intent.mts && tsx tests/runner-panel.mts && tsx tests/deck-edit.mts && tsx tests/re-review.mts && tsx tests/snapshot.mts && tsx tests/interrupted.mts && tsx tests/stopped.mts && tsx tests/no-retry-loop.mts",
    "build": "bb plugin build"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
}
